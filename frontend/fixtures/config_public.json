  "default_mode": "hybrid",
  "question_schema_version": "q1.2",
  "policy_version": "p1.2",
  "policy": {
    "version": "p1.2",
    "read": {
      "relevance": 0.5,
      "utility": 0.3,
      "band": 0.15,
      "intent_confidence": 0.7
    },
    "write": {
      "relation": 0.6,
      "confidence": 0.5,
      "instruction": 0.5,
      "ttl_days": {
        "days": 7.0,
        "weeks": 42.0,
        "months": 180.0,
        "year": 365.0
      }
    },
    "ablation": {
      "utility": true,
      "supersession": true,
      "contradiction": true,
      "temporal": true,
      "intent": true
    },
    "inject_uncertain": false,
    "supersede_mode": "exclude"
  },
  "debug_payloads": true
