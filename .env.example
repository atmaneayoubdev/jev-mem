# --- Jev (TypeSafe System One) ---------------------------------------------
# Default route is OpenRouter's Decisions API: POST {JEV_BASE_URL}/v1/systemone
# JEV_API_KEY falls back to OPENROUTER_API_KEY, then TYPESAFE_API_KEY.
OPENROUTER_API_KEY=
# JEV_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api
# For direct TypeSafe access instead:
# JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13
JEV_MAX_CONCURRENCY=16
JEV_TIMEOUT_S=30

# --- Qwen (OpenAI-compatible, e.g. vLLM) -----------------------------------
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_MAX_CONCURRENCY=16
QWEN_TIMEOUT_S=120
QWEN_ENABLE_THINKING=false

# --- Optional embedding baseline (pip install -e ".[embeddings]") -----------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Application -----------------------------------------------------------
DATA_DIR=./data
MEMORY_CONTEXT_TOKEN_BUDGET=1024
LOG_LEVEL=INFO
ENVIRONMENT=development
